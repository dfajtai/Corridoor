#!/bin/sh
# Writes the version "<base>.<commit id>" into corridoor/_version.py after
# every commit. <base> is the first line of the VERSION file; it changes only
# when the maintainer asks for it. The generated file is not tracked by git
# (see .gitignore), so this hook never leaves the working tree dirty.
#
# Enable it once per clone with: githooks\install.ps1
root=$(git rev-parse --show-toplevel) || exit 0
base=$(head -n 1 "$root/VERSION" | tr -d '\r\n ')
id=$(git rev-parse --short HEAD) || exit 0
printf '"""Generated by githooks/post-commit; not tracked by git."""\n\n__version__ = "%s.%s"\n' \
    "$base" "$id" > "$root/corridoor/_version.py"
